rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Único profesional autorizado con potestad legal y custodia clínica
    function isAuthorizedDoctor() {
      return isAuthenticated() && request.auth.token.email == 'josealejot@gmail.com';
    }

    // Colección Pacientes: Solo el Dr. José Alejandro puede gestionar pacientes
    match /pacientes/{pacienteId} {
      allow read, write: if isAuthorizedDoctor();
    }

    // Colección Historias Clínicas: Custodia estricta Ley 1090 / Res. 1995 de 1999
    match /historias_clinicas/{historiaId} {
      allow read, write: if isAuthorizedDoctor();
      allow delete: if false; // Prohibición legal de eliminación
    }

    // Colección Evaluaciones 16PF
    match /evaluaciones_16pf/{evaluacionId} {
      allow read, write: if isAuthorizedDoctor();
      allow delete: if false;
    }

    // Colección Certificados MAE
    match /certificados/{certificadoId} {
      allow read: if true; // Lectura pública para verificación por código QR
      allow create, update: if isAuthorizedDoctor(); // Solo el Dr. puede emitir certificados
      allow delete: if false; // Inmutabilidad legal del documento
    }
  }
}
